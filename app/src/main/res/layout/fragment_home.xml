<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvHomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenue"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp"/>

        <ImageView
            android:id="@+id/ivHomeCover"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bgcover"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnAddRestaurant"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ajouter un restaurant"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary_dark"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnViewRestaurants"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Voir la liste des restaurants"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_dark" />

    </LinearLayout>
</ScrollView>
