<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    >

    <!-- Bouton Retour -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Retour"
        android:backgroundTint="@color/primary_dark"
        android:textColor="@android:color/white"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Image du menu (optionnelle) -->
            <ImageView
                android:id="@+id/ivMenuImage"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:background="#DDDDDD" />

            <Button
                android:id="@+id/btnPickMenuImage"
                android:layout_marginTop="10dp"
                android:text="Choisir Image"
                android:backgroundTint="@color/accent_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Nom du menu -->
            <EditText
                android:id="@+id/etMenuTitle"
                android:layout_marginTop="20dp"
                android:hint="Titre du menu"
                android:textColorHint="@color/text_secondary"
                android:textColor="@android:color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Description du menu (max 10 mots) -->
            <EditText
                android:id="@+id/etMenuDescription"
                android:layout_marginTop="10dp"
                android:hint="Description "
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:textColorHint="@color/text_secondary"
                android:textColor="@android:color/black"
                android:importantForAutofill="no"/>

            <!-- Bouton pour ajouter le menu -->
            <Button
                android:id="@+id/btnSaveMenu"
                android:layout_marginTop="20dp"
                android:text="Ajouter Menu"
                android:backgroundTint="@color/primary_dark"
android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
